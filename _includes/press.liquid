<div class="news mt-3 mb-4">
  <h4 class="mb-3">Selected Recognition &amp; Press</h4>
  {% if site.projects != blank -%}
    <div class="table-responsive">
      <table class="table table-sm table-borderless mb-0">
      {%- assign news = site.projects | sort: "date" | reverse -%}
      {% for item in news %}
        <tr>
          <th scope="row" class="text-muted" style="width: 8%; vertical-align: baseline; font-family: monospace; font-weight: 500; font-size: 0.85rem; padding-left: 0;">
            {{ item.date | date: "%Y" }}
          </th>
          <td style="padding-bottom: 0.45rem; font-size: 0.92rem;">
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          </td>
        </tr>
      {%- endfor %}
      </table>
    </div>
  {%- else -%}
    <p>No news so far...</p>
  {%- endif %}
</div>
