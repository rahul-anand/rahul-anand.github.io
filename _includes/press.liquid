<div class="news">
  <h2>Selected Recognition & Press</h2>
  {% if site.projects != blank -%}
    {%- assign news_size = site.projects | size -%}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
      {%- assign news = site.projects | sort: "date" | reverse -%}
      {% for item in news %}
        <tr>
          <th scope="row" style="width: 5%; vertical-align: top; padding-top: 0.35rem;">
            <i class="fa-solid fa-award text-warning"></i>
          </th>
          <td style="padding-bottom: 0.6rem;">
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          </td>
        </tr>
      {%- endfor %}
      </table>
    </div>
  {%- else -%}
    <p>No news so far...</p>
  {%- endif %}
</div>
