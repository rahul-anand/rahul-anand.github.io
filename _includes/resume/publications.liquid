<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.releaseDate %} {% assign date = content.releaseDate | split: '-' | slice: 0, 1 | first %} {% else %} {% assign date = '' %} {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark align-middle" style="min-width: 75px; font-family: monospace;">{{ date }}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4 mb-0">
            <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4 mt-1 mb-1" style="font-size: 0.92rem; font-family: monospace; color: var(--global-theme-color);">{{ content.publisher }}</h6>
          <h6 class="ml-1 ml-md-4 text-muted" style="font-size: 0.92rem;">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
