<div class="px-1">
  <table class="table table-sm table-borderless mb-0">
    <tbody>
      {% for content in data[1] %}
        <tr>
          <td class="font-weight-bold pr-3 py-1" style="width: 28%; vertical-align: baseline; font-size: 0.92rem;">
            {% if content.icon %}<i class="{{ content.icon }} mr-1 text-muted" style="width: 1.1rem;"></i>{% endif %}
            {{ content.name }}
          </td>
          <td class="py-1 text-muted" style="vertical-align: baseline; font-size: 0.92rem;">
            {{ content.keywords | join: ' &middot; ' }}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
