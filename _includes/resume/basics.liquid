<div class="px-1">
  <p class="mb-2" style="font-size: 0.96rem; line-height: 1.55;">
    {{ data[1].summary }}
  </p>
  <div class="text-muted small d-flex flex-wrap align-items-center" style="font-family: monospace; font-size: 0.84rem; gap: 0.5rem;">
    <span><i class="fa-solid fa-location-dot"></i> {{ data[1].location.city }}, {{ data[1].location.region }}</span>
    <span>&middot;</span>
    <a href="mailto:{{ data[1].email }}">{{ data[1].email }}</a>
    {% for profile in data[1].profiles %}
      <span>&middot;</span>
      <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">{{ profile.network }}</a>
    {% endfor %}
  </div>
</div>
